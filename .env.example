# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real credentials.

# PostgreSQL
POSTGRES_DB=stridesync
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_PORT=5432

# pgAdmin (optional, only used by docker-compose)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password
PGADMIN_PORT=5050

# Ktor server
DB_URL=jdbc:postgresql://localhost:5432/stridesync
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT — generate a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
JWT_ISSUER=stridesync
JWT_AUDIENCE=stridesync-users
